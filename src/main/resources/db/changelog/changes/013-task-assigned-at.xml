<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="035-tasks-assigned-at" author="jahja">
        <addColumn tableName="tasks">
            <column name="assigned_at" type="TIMESTAMP"/>
        </addColumn>
        <update tableName="tasks">
            <column name="assigned_at" valueComputed="now()"/>
            <where>status = 'ASSIGNED'</where>
        </update>
        <rollback>
            <dropColumn tableName="tasks" columnName="assigned_at"/>
        </rollback>
    </changeSet>

</databaseChangeLog>

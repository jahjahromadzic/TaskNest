<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="009-create-tasks" author="jahja">
        <createTable tableName="tasks">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="client_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="category_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="municipality_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="budget" type="DECIMAL(10,2)"/>
            <column name="status" type="VARCHAR(20)" defaultValue="DRAFT">
                <constraints nullable="false"/>
            </column>
            <column name="accepted_offer_id" type="UUID"/>
            <column name="published_at" type="TIMESTAMP"/>
            <column name="expires_at" type="TIMESTAMP"/>
            <column name="completed_at" type="TIMESTAMP"/>
            <column name="version" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="tasks" baseColumnNames="client_id"
                referencedTableName="users" referencedColumnNames="id"
                constraintName="fk_tasks_client"/>
        <addForeignKeyConstraint
                baseTableName="tasks" baseColumnNames="category_id"
                referencedTableName="categories" referencedColumnNames="id"
                constraintName="fk_tasks_category"/>
        <addForeignKeyConstraint
                baseTableName="tasks" baseColumnNames="municipality_id"
                referencedTableName="municipalities" referencedColumnNames="id"
                constraintName="fk_tasks_municipality"/>
    </changeSet>

    <changeSet id="010-create-offers" author="jahja">
        <createTable tableName="offers">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="task_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="tasker_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="message" type="VARCHAR(1000)"/>
            <column name="status" type="VARCHAR(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="offers" baseColumnNames="task_id"
                referencedTableName="tasks" referencedColumnNames="id"
                constraintName="fk_offers_task"/>
        <addForeignKeyConstraint
                baseTableName="offers" baseColumnNames="tasker_id"
                referencedTableName="users" referencedColumnNames="id"
                constraintName="fk_offers_tasker"/>
        <addUniqueConstraint
                tableName="offers" columnNames="task_id, tasker_id"
                constraintName="uq_offers_task_tasker"/>
    </changeSet>

    <changeSet id="011-add-accepted-offer-fk" author="jahja">
        <addForeignKeyConstraint
                baseTableName="tasks" baseColumnNames="accepted_offer_id"
                referencedTableName="offers" referencedColumnNames="id"
                constraintName="fk_tasks_accepted_offer"/>
    </changeSet>

</databaseChangeLog>
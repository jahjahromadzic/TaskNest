<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="021-index-tasker-categories-category" author="jahja">
        <createIndex tableName="tasker_categories" indexName="idx_tasker_categories_category">
            <column name="category_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="022-index-tasker-municipalities-municipality" author="jahja">
        <createIndex tableName="tasker_municipalities" indexName="idx_tasker_municipalities_municipality">
            <column name="municipality_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="023-index-tasks-client" author="jahja">
        <createIndex tableName="tasks" indexName="idx_tasks_client">
            <column name="client_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="024-index-tasks-feed" author="jahja">
        <createIndex tableName="tasks" indexName="idx_tasks_municipality_category_status">
            <column name="municipality_id"/>
            <column name="category_id"/>
            <column name="status"/>
        </createIndex>
    </changeSet>

    <changeSet id="025-index-tasks-status-expires" author="jahja">
        <createIndex tableName="tasks" indexName="idx_tasks_status_expires_at">
            <column name="status"/>
            <column name="expires_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="026-index-offers-tasker" author="jahja">
        <createIndex tableName="offers" indexName="idx_offers_tasker">
            <column name="tasker_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="027-index-messages-conversation-created" author="jahja">
        <createIndex tableName="messages" indexName="idx_messages_conversation_created_at">
            <column name="conversation_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="028-index-notifications-recipient-created" author="jahja">
        <createIndex tableName="notifications" indexName="idx_notifications_recipient_created_at">
            <column name="recipient_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="029-index-reviews-reviewee" author="jahja">
        <createIndex tableName="reviews" indexName="idx_reviews_reviewee">
            <column name="reviewee_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
